# Reverse proxy with automatic HTTPS (Let's Encrypt).
# SITE_DOMAIN and ACME_EMAIL come from the environment (see docker-compose.yml / .env).
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Response headers set by the app (CSP, HSTS, ...) are passed through untouched.
	header -Server

	reverse_proxy app:3000 {
		# Overwrite, never append: the app trusts X-Forwarded-For only because of this.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
