# متغیرهای محیطی سرویس API (در sitectl خودکار ساخته می‌شوند؛ این فایل برای نصب دستی/لوکال است)
# ساخت رمز تصادفی:  openssl rand -hex 32
DATABASE_URL=postgresql://paramistech:CHANGE_ME@127.0.0.1:5432/paramistech
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
PORT=3102
HOST=127.0.0.1
UPLOAD_DIR=/srv/sites/paramistech/shared/uploads
SITE_DOMAIN=example.ir
NODE_ENV=production
# اختیاری
# UPLOAD_MAX=10mb
# PG_POOL_MAX=10
