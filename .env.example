# Copy to .env and replace all example values. Never commit .env.

# --- Core ---
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5432/paramistech
# Public https URL of the site. Admin mutations accept only this host as Origin.
NEXT_PUBLIC_SITE_URL=https://example.com
POSTGRES_PASSWORD=replace-with-a-long-unique-database-password

# --- First admin (used only by scripts/seed-admin.mjs) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-14-characters

# --- Security ---
# SameSite of the admin session cookie: strict (default), lax or none.
# Use "none" only when the panel is embedded in a cross-site frame (a preview iframe): browsers refuse to
# store Strict/Lax cookies from a cross-site context, which makes the login look like it "just refreshes".
# None forces Secure and needs a browser that allows third-party cookies (Safari blocks them).
SESSION_COOKIE_SAMESITE=strict
# Required in production, 16+ random characters. Salts the hashed IP/email used for rate limits.
RATE_LIMIT_SALT=replace-with-a-unique-random-string-at-least-16-characters
# true ONLY when a trusted reverse proxy overwrites X-Forwarded-For (docker-compose.yml sets it for Caddy,
# and managed PaaS platforms like Liara put one in front of the app). X-Real-IP is preferred when the proxy
# sets it. Leave false when the app is reachable directly (all visitors then share one rate-limit bucket).
TRUST_PROXY=false

# --- Lead notifications (all optional; sent after the lead is stored, failures are only logged) ---
# Email via SMTP: set all of SMTP_HOST, SMTP_FROM and NOTIFY_EMAILS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAILS=
# Telegram pointer message (name, project type, admin link; never the free-text details)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Caddy (docker-compose.yml) ---
SITE_DOMAIN=example.com
ACME_EMAIL=admin@example.com

# --- Content visibility ---
# Sample rows (is_placeholder) are hidden in production unless this is true.
ALLOW_PLACEHOLDERS=false

# --- Optional privacy-friendly analytics (loads nothing unless BOTH are set; https only, never on /admin) ---
# The script gets the CSP nonce and its origin is added to the CSP. Sent as data-website-id and data-domain.
ANALYTICS_SCRIPT_URL=
ANALYTICS_SITE_ID=

# --- Uploads ---
UPLOADS_DIR=./data/uploads
